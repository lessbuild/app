includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    ignoreErrors:
        # TestResponse::assertJsonRedirect() is a macro added in tests/TestCase.php.
        - message: '#Call to an undefined method Illuminate\\Testing\\TestResponse<.*>::assertJsonRedirect\(\)#'
          identifier: method.notFound
    level: 8
    paths:
        - app
        - database
        - routes
        - tests
    tmpDir: storage/phpstan
    # v2's page tests, waiting to be rewritten as API tests in their slice (docs/plan.md).
    excludePaths:
        - tests/Pending
