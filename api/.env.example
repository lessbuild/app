APP_NAME=BuildPusher
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social sign-in (callback: ${APP_URL}/auth/{github|gitlab|bitbucket}/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_HOST=https://gitlab.com
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Billing (docs/phase-3-billing.md). Price IDs: recurring monthly prices matching app/Platform/Catalog.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEPLOY_STARTER=
STRIPE_PRICE_DEPLOY_PRO=
STRIPE_PRICE_DEPLOY_TEAM=
STRIPE_PRICE_DEPLOY_BUSINESS=
STRIPE_PRICE_DEPLOY_UNLIMITED=
STRIPE_PRICE_MONITORING_PRO=
STRIPE_PRICE_MONITORING_TEAM=
STRIPE_PRICE_MONITORING_SCALE=
STRIPE_PRICE_AUDIT_PRO=
STRIPE_PRICE_AUDIT_BUSINESS=
STRIPE_PRICE_AUDIT_PRO_YEARLY=
STRIPE_PRICE_AUDIT_BUSINESS_YEARLY=
STRIPE_PRICE_AUDIT_RUNS_USAGE=
STRIPE_METER_AUDIT_RUNS=

# Off-site copies of the platform database (php artisan platform:backup runs nightly). Any S3-compatible storage.
PLATFORM_BACKUP_S3_ENDPOINT=
PLATFORM_BACKUP_S3_REGION=auto
PLATFORM_BACKUP_S3_BUCKET=
PLATFORM_BACKUP_S3_KEY=
PLATFORM_BACKUP_S3_SECRET=

# Audit: Claude plays the visitor (the same key as the assistant), Playwright's Chromium is the browser, and Brave
# Search suggests competitors when a key is set.
ANTHROPIC_API_KEY=
AUDIT_MODEL=claude-opus-5
PLAYWRIGHT_BROWSERS_PATH=
BRAVE_SEARCH_API_KEY=
