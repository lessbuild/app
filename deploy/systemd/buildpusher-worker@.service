[Unit]
Description=Buildpusher queue worker (%i)
After=network.target buildpusher-php-fpm.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/buildpusher-unified/current
ExecStart=/usr/bin/php8.5 /var/www/buildpusher-unified/current/artisan queue:work %i --sleep=3 --tries=3 --timeout=75 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0007
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
