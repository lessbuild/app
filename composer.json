{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.15.5",
        "laravel/cashier": "^16.8",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.30",
        "laravel/horizon": "^5.49",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/telescope": "^5.23",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "opcodesio/log-viewer": "^3.24.2",
        "phpseclib/phpseclib": "~4.0.1",
        "spatie/async": "^1.8.2",
        "spatie/ssh": "^1.13",
        "symfony/yaml": "^8.1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.3",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Deployer\\": "app/Modules/Deployer/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:module-boundaries": "@php scripts/check-module-boundaries.php",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/fortify",
                "laravel/horizon",
                "laravel/passkeys"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
